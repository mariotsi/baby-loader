# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority"

# VAPID keys — generate with: npm run generate-vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:tu@example.com"

# Password for the /invia admin page
ADMIN_PASSWORD=""

# Secret used to sign the admin session cookie.
# Optional: falls back to ADMIN_PASSWORD, but setting it means changing the
# password does not silently keep old sessions valid.
SESSION_SECRET=""

# Optional: _id (in /admin/subscriptions) of your own device's subscription.
# When set, you get a push notification whenever a device other than yours
# subscribes or unsubscribes, with a link to the highlighted row in
# /admin/subscriptions. Without this variable the feature is simply disabled.
ADMIN_SUBSCRIPTION_ID=""
