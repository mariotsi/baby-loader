# Password for the /invia admin page
ADMIN_PASSWORD=""

# Secret used to sign the admin session cookie.
# Optional: falls back to ADMIN_PASSWORD, but setting it means changing the
# password does not silently keep old sessions valid.
SESSION_SECRET=""
